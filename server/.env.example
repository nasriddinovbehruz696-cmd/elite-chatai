# Твой бесплатный ключ с aistudio.google.com/apikey
GEMINI_API_KEY=

# Любая случайная строка для подписи токенов (можно придумать что угодно)
JWT_SECRET=change_this_to_something_random

PORT=5000

# Railway Volume mount path (use /data on Railway; local default is server/data)
DATA_DIR=

# Необязательный администратор: аккаунт автоматически создаётся при первом запуске, если заданы оба значения
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Google OAuth Client ID (same value as VITE_GOOGLE_CLIENT_ID in client/.env)
GOOGLE_CLIENT_ID=
